# انسخ هذا الملف إلى .env واملأ القيم الحقيقية

# اتصال التطبيق عبر Session Pooler (المنفذ 5432) — الخادم يعمل باستمرار فلا حاجة لـ Transaction Pooler (6543) الأبطأ
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres?connection_limit=5"
# Supabase — Session Pooler (المنفذ 5432) للـ migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
COOKIE_NAME=token

SEED_ADMIN_NAME="مدير الصالون"
SEED_ADMIN_EMAIL=admin@goldentouch.local
SEED_ADMIN_PASSWORD="change-me-strong-password"
# حساب مشرف الحجوزات (اختياري — يُنشأ فقط عند ضبط البريد وكلمة المرور معاً)
SEED_STAFF_NAME="مشرف الحجوزات"
SEED_STAFF_EMAIL=staff@goldentouch.local
SEED_STAFF_PASSWORD="change-me-staff-password"

# Web Push (تجربة الإشعارات) — ولّد زوج مفاتيح مختلفاً للتطوير: npx web-push generate-vapid-keys
# بدونهما تُعطَّل الميزة بهدوء. VAPID_SUBJECT اختياري (رابط https أو mailto:؛ الافتراضي رابط الموقع على Render)
# PUSH_ALERT_MINUTES: الإنذار قبل بداية الموعد (الافتراضي 15؛ 0 = معطّل)
PUSH_ALERT_MINUTES=15
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
