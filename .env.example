# ─────────────────────────────────────────────────────────────
# مرجع لكل متغيرات البيئة في المشروع.
# الملفات الفعلية تُقرأ من:
#   apps/api/.env  ← متغيرات الـ API و Prisma
#   apps/web/.env  ← متغيرات الواجهة
# ─────────────────────────────────────────────────────────────

# ── قاعدة البيانات (Supabase) ──
# اتصال التطبيق عبر Session Pooler (المنفذ 5432) — الخادم يعمل باستمرار فلا حاجة لـ Transaction Pooler (6543) الأبطأ
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres?connection_limit=5"
# اتصال مباشر عبر Session Pooler (المنفذ 5432) — تستخدمه Prisma للـ migrations فقط
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# ── الـ API ──
PORT=4000
NODE_ENV=development
# سلسلة عشوائية طويلة (32 حرفاً على الأقل)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# مدة صلاحية الجلسة (صيغة vercel/ms مثل 7d أو 12h)
JWT_EXPIRES_IN=30d
# أصل الواجهة المسموح له (CORS)
CORS_ORIGIN=http://localhost:3000
# اسم كوكي التوكن
COOKIE_NAME=token

# ── الإنتاج على Render ──
# منفذ الـ API الداخلي حين يعمل مع الواجهة في خدمة واحدة (scripts/start-prod.mjs)
API_PORT=4000
# مهمة إبقاء الخادم مستيقظاً: تطلب /api/health عبر الرابط العام كل N دقيقة.
# على Render يُستخدم RENDER_EXTERNAL_URL تلقائياً؛ KEEP_ALIVE_URL لتحديد رابط آخر يدوياً.
# KEEP_ALIVE_URL=https://golden-touch.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=10

# ── الـ seed (حساب المدير الأول) ──
SEED_ADMIN_NAME="مدير الصالون"
SEED_ADMIN_EMAIL=admin@goldentouch.local
SEED_ADMIN_PASSWORD="change-me-strong-password"

# ── الواجهة ──
# عنوان الـ API الذي تمرّر إليه الواجهة طلبات /api/**
API_BASE_URL=http://localhost:4000
