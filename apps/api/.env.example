# انسخ هذا الملف إلى .env واملأ القيم الحقيقية

# اتصال التطبيق عبر Session Pooler (المنفذ 5432) — الخادم يعمل باستمرار فلا حاجة لـ Transaction Pooler (6543) الأبطأ
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres?connection_limit=5"
# Supabase — Session Pooler (المنفذ 5432) للـ migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
COOKIE_NAME=token

SEED_ADMIN_NAME="مدير الصالون"
SEED_ADMIN_EMAIL=admin@goldentouch.local
SEED_ADMIN_PASSWORD="change-me-strong-password"
